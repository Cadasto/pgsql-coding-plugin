{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash hooks/session-start.sh",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "bash hooks/lint-on-save.sh",
        "matcher": "Write",
        "timeout": 20
      },
      {
        "command": "bash hooks/skill-nudge.sh",
        "matcher": "Write",
        "timeout": 5
      }
    ]
  }
}
